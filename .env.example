# Copy to .env.local (never commit .env.local).
# ONLY the public URL and the publishable/anon key belong here.
# Never put the service-role / secret key in an EXPO_PUBLIC_ variable: it is
# inlined into the app bundle. The app refuses to start if it detects one.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=<publishable key from `supabase status`>
